---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TagLinks from '../components/TagLinks.astro';
import { entryLd } from '../lib/structuredData';
import { COLLECTION_LABELS } from '../lib/tags';
import BaseLayout from './BaseLayout.astro';

type Collection = 'pictures' | 'pixelarts' | 'mcskins' | 'apps';

type Props = CollectionEntry<Collection>['data'] & {
	id: string;
	collection: Collection;
};

const { title, description, author, pubDate, updatedDate, tags, id, collection } = Astro.props;
const ogSlug = id.replace(/\.(md|mdx)$/, '');
const ogImageUrl = `/og/light/${collection}/${ogSlug}.png`;

const site = Astro.site!;
const props = Astro.props;
const structuredData = entryLd({
	collection,
	url: new URL(Astro.url.pathname, site),
	site,
	title,
	description,
	author,
	pubDate,
	updatedDate,
	tags,
	images: [...('contentImages' in props ? props.contentImages : []), new URL(ogImageUrl, site).href],
	appUrl: 'url' in props ? props.url : undefined,
});
---

<BaseLayout
	title={title}
	description={description}
	ogImageUrl={ogImageUrl}
	structuredData={structuredData}
>
	<nav aria-label="パンくずリスト" class="mx-auto mb-6 max-w-3xl text-sm">
		<ol class="flex flex-wrap items-center gap-2">
			<li>
				<a href={`/${collection}/`} class="text-text-muted transition-colors hover:text-text-heading">
					{COLLECTION_LABELS[collection]}
				</a>
			</li>
			<li aria-hidden="true" class="text-text-muted">/</li>
			<li aria-current="page" class="font-medium text-text-heading">{title}</li>
		</ol>
	</nav>
	<article class="mx-auto max-w-3xl">
		<header class="mb-8 border-b border-border-default pb-8">
			<h1 class="text-3xl font-bold text-text-heading">{title}</h1>
			<p class="mt-2 flex flex-wrap gap-x-3 text-sm text-text-muted">
				<span>{author}</span>
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span>
							更新: <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<div class="mt-4">
				<TagLinks tags={tags} />
			</div>
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
</BaseLayout>
