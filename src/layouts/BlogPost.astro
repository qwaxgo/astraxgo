---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TagLinks from '../components/TagLinks.astro';
import { entryLd } from '../lib/structuredData';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { title, description, author, pubDate, updatedDate, heroImage, tags, id } = Astro.props;
const ogSlug = id.replace(/\.(md|mdx)$/, '');
const ogImageUrl = `/og/light/blog/${ogSlug}.png`;

const site = Astro.site!;
const structuredData = entryLd({
	collection: 'blog',
	url: new URL(Astro.url.pathname, site),
	site,
	title,
	description,
	author,
	pubDate,
	updatedDate,
	tags,
	images: [
		...(heroImage ? [new URL(heroImage.src, Astro.url).href] : []),
		new URL(ogImageUrl, site).href,
	],
});
---

<BaseLayout
	title={title}
	description={description}
	ogImageUrl={ogImageUrl}
	structuredData={structuredData}
>
	<article class="mx-auto max-w-3xl">
		{
			heroImage && (
				<Image
					width={1020}
					height={510}
					src={heroImage}
					alt=""
					class="mb-10 w-full rounded-xl border border-border-default"
				/>
			)
		}
		<header class="mb-10 border-b border-border-default pb-8">
			<p class="flex flex-wrap gap-x-3 text-sm text-text-muted">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span>
							更新: <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<h1 class="mt-2 text-3xl font-bold text-text-heading">{title}</h1>
			<div class="mt-4">
				<TagLinks tags={tags} />
			</div>
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
</BaseLayout>
