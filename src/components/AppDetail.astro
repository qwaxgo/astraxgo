---
import { Image } from 'astro:assets';
import { type CollectionEntry, render } from 'astro:content';
import { getAppScreenshot } from '../lib/appScreenshots';
import Icon from './Icon.astro';

interface Props {
	entry: CollectionEntry<'apps'>;
}

// Body of an app's detail: shared by /apps/<id>/ and the popup on /apps/.
const { entry } = Astro.props;
const { title, url, repoUrl } = entry.data;
const screenshot = getAppScreenshot(entry.id);
const { Content } = await render(entry);
---

{
	screenshot && (
		<a
			href={url}
			target="_blank"
			rel="noopener"
			class="block overflow-hidden rounded-xl border border-border-default shadow-sm transition-shadow hover:shadow-md focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
		>
			<Image
				src={screenshot}
				alt={`${title}のトップページ`}
				widths={[720, 1280]}
				sizes="720px"
				class="block h-auto w-full"
			/>
		</a>
	)
}
<div class="mt-6 flex flex-wrap gap-3">
	<a
		href={url}
		target="_blank"
		rel="noopener"
		class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary-500 pr-4 pl-3 text-[1rem] font-medium text-white transition-colors hover:bg-primary-700 focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
	>
		<Icon name="OpenInNew" />
		アプリを開く
	</a>
	<a
		href={repoUrl}
		target="_blank"
		rel="noopener"
		class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-border-default bg-bg-surface px-4 text-[1rem] font-medium text-body transition-colors hover:bg-bg-surface-alt focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
	>
		GitHub
	</a>
</div>
<div class="prose mt-8">
	<Content />
</div>
