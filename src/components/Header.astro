---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header data-site-header class="group/header sticky top-0 z-30 border-b border-border-default bg-bg-surface">
	<nav
		aria-label="メインナビゲーション"
		class="mx-auto flex h-16 max-w-[1042px] items-center justify-between gap-4 px-4"
	>
		<a
			href="/"
			class="rounded-lg text-lg font-bold text-text-heading focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
		>
			{SITE_TITLE}
		</a>
		<button
			type="button"
			class="group inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-text-heading transition-colors hover:bg-bg-page-alt focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none nav:hidden"
			aria-expanded="false"
			aria-controls="site-menu"
			aria-label="メニューを開く"
			data-menu-toggle
		>
			<Icon name="Menu" class="h-5 w-5 group-aria-expanded:hidden" />
			<Icon name="Close" class="hidden h-5 w-5 group-aria-expanded:block" />
		</button>
		<div
			id="site-menu"
			class="absolute inset-x-0 top-full hidden flex-col gap-3 border-b border-border-default bg-bg-surface px-4 pt-2 pb-4 shadow-md group-data-open/header:flex nav:static nav:flex nav:flex-row nav:items-center nav:gap-2 nav:border-0 nav:p-0 nav:shadow-none"
		>
			<ul class="flex flex-col gap-1 nav:flex-row nav:gap-0.5">
				<li><HeaderLink href="/">Home</HeaderLink></li>
				<li><HeaderLink href="/blog">Blog</HeaderLink></li>
				<li><HeaderLink href="/pictures">Pictures</HeaderLink></li>
				<li><HeaderLink href="/pixelarts">Pixelarts</HeaderLink></li>
				<li><HeaderLink href="/mcskins">MCSkins</HeaderLink></li>
				<li><HeaderLink href="/apps">Apps</HeaderLink></li>
				<li><HeaderLink href="/tags">Tags</HeaderLink></li>
				<li><HeaderLink href="/about">About</HeaderLink></li>
			</ul>
			<div
				class="flex flex-wrap items-center justify-between gap-2 border-t border-border-default pt-3 nav:border-t-0 nav:border-l nav:pt-0 nav:pl-2"
			>
				<ThemeToggle />
				<SocialLinks compact />
			</div>
		</div>
	</nav>
</header>

<script>
	// Hamburger menu below the `nav` breakpoint (1100px, where the links fit on one
	// line): the button opens the links as a panel under the header. Esc, a click
	// outside, or widening the window closes it.
	const header = document.querySelector<HTMLElement>('[data-site-header]')!;
	const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;

	const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
	function setOpen(open: boolean) {
		header.toggleAttribute('data-open', open);
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
	}

	toggle.addEventListener('click', () => setOpen(!isOpen()));
	document.addEventListener('keydown', event => {
		if (event.key === 'Escape' && isOpen()) {
			setOpen(false);
			toggle.focus();
		}
	});
	document.addEventListener('click', event => {
		if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
	});
	matchMedia('(min-width: 1100px)').addEventListener('change', event => {
		if (event.matches) setOpen(false);
	});
</script>
