---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { documentTitle, SITE_TITLE } from '../consts';
import { OG_FORMATS, ogImagePath, type OgRef, pageRefFor } from '../lib/og/cards';

interface Props {
	/** Page name; omitted on the home page. */
	title?: string;
	description: string;
	/** Share card to use; defaults to the card of the page's section (or the home card). */
	og?: OgRef;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, og = pageRefFor(Astro.url.pathname) } = Astro.props;

// Tabs and search results get the page name joined with the site name. Share cards
// (og / twitter) show the site separately, so they keep the page name alone.
const tabTitle = documentTitle(title);
const cardTitle = title ?? SITE_TITLE;

// Landscape first: most link previews use the first og:image. The square one follows
// for apps that crop to a square.
const ogImages = (['wide', 'square'] as const).map(format => ({
	url: new URL(ogImagePath(og, format), Astro.site),
	...OG_FORMATS[format],
}));
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<script is:inline>
	(() => {
		const storageKey = 'qwaxgo-theme';
		const doc = document.documentElement;
		const transitionClass = 'theme-disable-transitions';
		let transitionTimeout = 0;

		const normalize = (theme) => (theme === 'dark' ? 'dark' : 'light');
		const tryGetStoredTheme = () => {
			try {
				return localStorage.getItem(storageKey);
			} catch (error) {
				return null;
			}
		};

		const withoutTransitions = (callback) => {
			if (typeof callback !== 'function') return;
			doc.classList.add(transitionClass);
			window.clearTimeout(transitionTimeout);
			callback();
			transitionTimeout = window.setTimeout(() => {
				doc.classList.remove(transitionClass);
			}, 120);
		};

		const applyTheme = (theme, { persist = false, emit = true } = {}) => {
			const normalized = normalize(theme);
			doc.dataset.theme = normalized;
			doc.classList.toggle('theme-dark', normalized === 'dark');
			doc.classList.toggle('theme-light', normalized === 'light');
			if (persist) {
				try {
					localStorage.setItem(storageKey, normalized);
				} catch (error) {
					/* ignore */
				}
			}
			if (emit) {
				doc.dispatchEvent(new CustomEvent('themechange', { detail: normalized }));
			}
		};

		const initialTheme = (() => {
			const stored = tryGetStoredTheme();
			if (stored === 'light' || stored === 'dark') return stored;
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		})();

		applyTheme(initialTheme, { persist: false, emit: false });

		const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
		const handleSystemChange = (event) => {
			if (tryGetStoredTheme()) return;
			withoutTransitions(() => applyTheme(event.matches ? 'dark' : 'light'));
		};
		if (typeof mediaQuery.addEventListener === 'function') {
			mediaQuery.addEventListener('change', handleSystemChange);
		} else if (typeof mediaQuery.addListener === 'function') {
			mediaQuery.addListener(handleSystemChange);
		}

		window.__theme = {
			current: () => doc.dataset.theme || 'light',
			set: (theme, persist = true) =>
				withoutTransitions(() => applyTheme(theme, { persist, emit: true })),
			toggle: () => {
				const nextTheme = doc.dataset.theme === 'dark' ? 'light' : 'dark';
				withoutTransitions(() => applyTheme(nextTheme, { persist: true, emit: true }));
				return nextTheme;
			},
			clear: () => {
				try {
					localStorage.removeItem(storageKey);
				} catch (error) {
					/* ignore */
				}
			},
		};
	})();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{tabTitle}</title>
<meta name="title" content={tabTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={cardTitle} />
<meta property="og:description" content={description} />
{
	ogImages.map(image => (
		<>
			<meta property="og:image" content={image.url} />
			<meta property="og:image:type" content="image/png" />
			<meta property="og:image:width" content={String(image.width)} />
			<meta property="og:image:height" content={String(image.height)} />
			<meta property="og:image:alt" content={cardTitle} />
		</>
	))
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={cardTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImages[0].url} />
<meta name="twitter:image:alt" content={cardTitle} />
