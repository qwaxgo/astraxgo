---
import { SITE_AUTHOR } from '../consts';
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer class="border-t border-border-default bg-bg-surface">
	<div
		class="mx-auto flex max-w-[1042px] flex-col-reverse items-center gap-4 px-4 py-8 sm:flex-row sm:justify-between"
	>
		<p class="text-sm text-text-muted">&copy; {today.getFullYear()} {SITE_AUTHOR}. All rights reserved.</p>
		<SocialLinks />
	</div>
</footer>
