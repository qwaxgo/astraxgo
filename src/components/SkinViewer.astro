---
import Icon from './Icon.astro';

interface Props {
	src: string;
	alt: string;
}

const { src, alt } = Astro.props;

// The image host sends no CORS headers, so WebGL can't sample it directly in the
// browser, and `<a download>` is ignored for cross-origin URLs. Skins are only a
// few KB, so inline them as data URIs at render time for both.
async function toDataUrl(url: string): Promise<string | undefined> {
	try {
		const res = await fetch(url);
		if (!res.ok) return undefined;
		const type = res.headers.get('content-type') ?? 'image/png';
		const base64 = Buffer.from(await res.arrayBuffer()).toString('base64');
		return `data:${type};base64,${base64}`;
	} catch {
		return undefined;
	}
}

const skin = await toDataUrl(src);
const fileName = decodeURIComponent(new URL(src).pathname.split('/').pop() || 'skin.png');

// images.qwaxgo.com rejects foreign Referers (hotlink protection), so localhost
// must send none during dev. Production keeps the default qwaxgo.com Referer.
const referrerPolicy = import.meta.env.DEV ? 'no-referrer' : undefined;
---

{
	skin ? (
		<div class="flex w-full max-w-[320px] flex-col items-center gap-4" data-skin-viewer data-skin={skin}>
			<div class="aspect-[3/4] w-full cursor-grab active:cursor-grabbing" data-stage>
				<canvas class="block" aria-label={`${alt}（3D表示・ドラッグで回転）`} />
			</div>
			<div class="flex flex-wrap justify-center gap-2" role="toolbar" aria-label="3D表示の操作" data-toolbar>
				<button type="button" data-action="zoom-in" aria-label="拡大" title="拡大" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-border-default bg-bg-surface text-body transition-colors hover:bg-bg-surface-alt focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none">
					<Icon name="ZoomIn" class="h-6 w-6" />
				</button>
				<button type="button" data-action="zoom-out" aria-label="縮小" title="縮小" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-border-default bg-bg-surface text-body transition-colors hover:bg-bg-surface-alt focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none">
					<Icon name="Subtract" />
				</button>
				<button type="button" data-action="rotate-left" aria-label="左に回転" title="左に回転" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-border-default bg-bg-surface text-body transition-colors hover:bg-bg-surface-alt focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none">
					<Icon name="Rotate90DegreesCc" />
				</button>
				<button type="button" data-action="rotate-right" aria-label="右に回転" title="右に回転" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-border-default bg-bg-surface text-body transition-colors hover:bg-bg-surface-alt focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none">
					<Icon name="Rotate90DegreesC" />
				</button>
				<button
					type="button"
					data-action="auto-rotate"
					title="自動回転"
					aria-pressed="true"
					class="inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-lg border border-border-default bg-bg-surface pr-4 pl-3 text-[1rem] font-medium text-body transition-colors hover:bg-bg-surface-alt focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none aria-pressed:border-primary-200 aria-pressed:bg-bg-accent-subtle aria-pressed:text-text-accent dark:aria-pressed:border-primary-800 relative after:absolute after:inset-x-0 after:top-1/2 after:h-11 after:-translate-y-1/2"
				>
					<Icon name="ReloadLoop" />
					自動回転
				</button>
			</div>
			<a
				href={skin}
				download={fileName}
				class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-primary-500 pr-4 pl-3 text-[1rem] font-medium text-white transition-colors hover:bg-primary-700 focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
			>
				<Icon name="DownloadAlt" />
				スキンをダウンロード
			</a>
		</div>
	) : (
		<img
			src={src}
			alt={alt}
			loading="lazy"
			referrerpolicy={referrerPolicy}
			class="w-full max-w-[320px] [image-rendering:pixelated]"
		/>
	)
}

<script>
	import { IdleAnimation, SkinViewer } from 'skinview3d';

	const ZOOM_STEP = 0.15;
	const ZOOM_MIN = 0.4;
	const ZOOM_MAX = 2;
	const ROTATE_STEP = Math.PI / 4;

	function initViewer(container: HTMLElement) {
		const stage = container.querySelector<HTMLElement>('[data-stage]');
		const canvas = stage?.querySelector('canvas');
		const skin = container.dataset.skin;
		if (!stage || !canvas || !skin) return;

		const viewer = new SkinViewer({
			canvas,
			width: stage.clientWidth,
			height: stage.clientHeight,
			skin,
			animation: new IdleAnimation(),
		});
		viewer.autoRotate = true;
		viewer.autoRotateSpeed = 0.6;
		viewer.controls.enableZoom = false;

		const autoRotateButton = container.querySelector<HTMLButtonElement>('[data-action="auto-rotate"]');
		const setAutoRotate = (on: boolean) => {
			viewer.autoRotate = on;
			autoRotateButton?.setAttribute('aria-pressed', String(on));
		};

		container.querySelector('[data-toolbar]')?.addEventListener('click', event => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
			switch (button?.dataset.action) {
				case 'zoom-in':
					viewer.zoom = Math.min(ZOOM_MAX, viewer.zoom + ZOOM_STEP);
					break;
				case 'zoom-out':
					viewer.zoom = Math.max(ZOOM_MIN, viewer.zoom - ZOOM_STEP);
					break;
				case 'rotate-left':
				case 'rotate-right':
					// Stepping while auto-rotating would be lost in the motion, so stop it.
					setAutoRotate(false);
					viewer.playerWrapper.rotation.y +=
						button.dataset.action === 'rotate-left' ? -ROTATE_STEP : ROTATE_STEP;
					break;
				case 'auto-rotate':
					setAutoRotate(!viewer.autoRotate);
					break;
			}
		});

		new ResizeObserver(() => viewer.setSize(stage.clientWidth, stage.clientHeight)).observe(stage);
	}

	// Each viewer holds a WebGL context, so only create them once they scroll into
	// view. Viewers inside a closed spoiler <details> start when it is opened.
	const observer = new IntersectionObserver(entries => {
		for (const entry of entries) {
			if (!entry.isIntersecting) continue;
			observer.unobserve(entry.target);
			initViewer(entry.target as HTMLElement);
		}
	});
	document.querySelectorAll<HTMLElement>('[data-skin-viewer]').forEach(el => observer.observe(el));
</script>
