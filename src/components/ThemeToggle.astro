---
import Icon from './Icon.astro';
---

<button
	type="button"
	class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-body transition-colors hover:bg-bg-page-alt focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
	data-theme-toggle
	title="テーマを切り替え"
	aria-label="ダークモードに切り替え"
	aria-pressed="false"
>
	<Icon name="Moon" class="h-5 w-5 dark:hidden" />
	<Icon name="Sun" class="hidden h-5 w-5 dark:block" />
</button>

<script is:inline>
	(() => {
		const root = document.documentElement;

		const setState = (toggle, theme) => {
			const dark = theme === 'dark';
			toggle.setAttribute('aria-pressed', String(dark));
			toggle.setAttribute('aria-label', dark ? 'ライトモードに切り替え' : 'ダークモードに切り替え');
		};

		const init = () => {
			const toggle = document.querySelector('[data-theme-toggle]');
			if (!toggle) return;

			setState(toggle, window.__theme?.current?.() ?? root.dataset.theme ?? 'light');
			root.addEventListener('themechange', event => setState(toggle, event.detail));

			toggle.addEventListener('click', () => {
				if (window.__theme?.toggle) {
					window.__theme.toggle();
					return;
				}
				const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				root.dispatchEvent(new CustomEvent('themechange', { detail: next }));
			});
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init, { once: true });
		} else {
			init();
		}
	})();
</script>
