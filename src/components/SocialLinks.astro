---
import { SOCIAL_LINKS } from '../consts';
import SocialIcon from './SocialIcon.astro';

interface Props {
	/** Show each account's name and handle next to its icon (used on /about). */
	labels?: boolean;
	size?: number;
}

const { labels = false, size = 24 } = Astro.props;
---

<ul class:list={['social-links', { labels }]}>
	{
		SOCIAL_LINKS.map(link => (
			<li>
				<a href={link.href} target="_blank" rel="me noopener" title={`${link.label} ${link.handle}`}>
					<SocialIcon name={link.icon} size={size} />
					{labels ? (
						<span class="text">
							<span class="label">{link.label}</span>
							<span class="handle">{link.handle}</span>
						</span>
					) : (
						<span class="sr-only">{`${link.label} ${link.handle}`}</span>
					)}
				</a>
			</li>
		))
	}
</ul>

<style>
	.social-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--heading-color);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--accent);
		outline: none;
	}

	.labels {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 0.75rem;
	}
	.labels a {
		justify-content: flex-start;
		gap: 0.75em;
		width: 100%;
		box-sizing: border-box;
		padding: 0.6em 0.9em;
		border: 1px solid var(--border-color);
		border-radius: 10px;
		background: var(--surface);
	}
	.labels a:hover,
	.labels a:focus-visible {
		border-color: var(--accent);
	}
	.text {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
		text-align: left;
	}
	.label {
		font-weight: 700;
	}
	.handle {
		color: var(--muted-text-color);
		font-size: 0.85em;
	}
</style>
