---
import { SOCIAL_LINKS } from '../consts';
import SocialIcon from './SocialIcon.astro';

interface Props {
	/** Show each account's name and handle next to its icon (used on /about). */
	labels?: boolean;
	/** Tighter icon buttons on desktop, to fit the header on one line. */
	compact?: boolean;
}

const { labels = false, compact = false } = Astro.props;
---

{
	labels ? (
		<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3">
			{SOCIAL_LINKS.map(link => (
				<li>
					<a
						href={link.href}
						target="_blank"
						rel="me noopener"
						class="flex h-full items-center gap-3 rounded-xl border border-border-default bg-bg-surface px-4 py-3 shadow-sm transition-shadow hover:shadow-md focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
					>
						<SocialIcon name={link.icon} class="h-6 w-6 text-text-heading" />
						<span class="flex min-w-0 flex-col leading-normal">
							<span class="text-sm font-medium text-text-heading">{link.label}</span>
							<span class="truncate text-xs text-text-muted">{link.handle}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	) : (
		<ul class:list={['flex flex-wrap items-center', compact ? 'gap-1 nav:gap-0' : 'gap-1']}>
			{SOCIAL_LINKS.map(link => (
				<li>
					<a
						href={link.href}
						target="_blank"
						rel="me noopener"
						title={`${link.label} ${link.handle}`}
						aria-label={`${link.label} ${link.handle}`}
						class:list={[
							'inline-flex items-center justify-center rounded-lg text-body transition-colors hover:bg-bg-page-alt hover:text-text-heading focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none',
							compact ? 'h-10 w-10 nav:h-9 nav:w-9' : 'h-10 w-10',
						]}
					>
						<SocialIcon name={link.icon} class="h-5 w-5" />
					</a>
				</li>
			))}
		</ul>
	)
}
