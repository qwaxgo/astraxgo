---
import { tagSearchUrl } from '../lib/tags';

interface Props {
	tags: string[];
}

// A post's tags, each linking to the tag search across every collection.
const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="flex flex-wrap gap-2" aria-label="タグ">
			{tags.map(tag => (
				<li>
					<a
						href={tagSearchUrl(tag)}
						class="inline-flex items-center rounded-full bg-bg-page-alt px-3 py-1 text-xs font-medium text-body transition-colors hover:bg-bg-accent-subtle hover:text-text-accent focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
					>
						#{tag}
					</a>
				</li>
			))}
		</ul>
	)
}
