---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getSkinThumbnail } from '../lib/skinThumbnails';
import FormattedDate from './FormattedDate.astro';

interface Props {
	entries: CollectionEntry<'pictures' | 'pixelarts' | 'mcskins'>[];
	basePath: 'pictures' | 'pixelarts' | 'mcskins';
	/** `picture` scales smoothly; `pixelart` and `mcskin` use nearest-neighbour. */
	thumbnailMode: 'picture' | 'pixelart' | 'mcskin';
}

const { entries, basePath, thumbnailMode } = Astro.props;

// Skins use a still rendered from the 3D preview when one exists.
const items = entries.map(entry => ({
	entry,
	rendered: basePath === 'mcskins' ? getSkinThumbnail(entry.id) : undefined,
}));

// images.qwaxgo.com rejects foreign Referers (hotlink protection), so localhost
// must send none during dev. Production keeps the default qwaxgo.com Referer.
const referrerPolicy = import.meta.env.DEV ? 'no-referrer' : undefined;
---

{
	items.length === 0 ? (
		<p class="py-16 text-center text-base text-text-muted">まだ投稿はありません。</p>
	) : (
		<ul class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3">
			{items.map(({ entry, rendered }) => (
				<li>
					<a
						href={`/${basePath}/${entry.id}/`}
						class="flex h-full flex-col overflow-hidden rounded-xl border border-border-default bg-bg-surface shadow-sm transition-shadow hover:shadow-md focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
					>
						<div class="checkerboard flex aspect-square items-center justify-center border-b border-border-default">
							{rendered ? (
								<Image
									src={rendered}
									alt=""
									widths={[300, 600]}
									sizes="300px"
									class="h-full w-full object-contain"
								/>
							) : (
								<img
									src={entry.data.contentImages[0]}
									alt=""
									loading="lazy"
									referrerpolicy={referrerPolicy}
									class:list={[
										thumbnailMode === 'mcskin'
											? 'w-[55%] [image-rendering:pixelated]'
											: 'h-full w-full object-cover',
										{ '[image-rendering:pixelated]': thumbnailMode === 'pixelart' },
									]}
								/>
							)}
						</div>
						<div class="flex flex-1 flex-col p-4">
							<h2 class="text-lg font-semibold text-text-heading">{entry.data.title}</h2>
							<p class="mt-auto pt-1 text-xs text-text-muted">
								<FormattedDate date={entry.data.pubDate} />
							</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	)
}
