---
import Icon from './Icon.astro';
import SkinViewer from './SkinViewer.astro';

interface Props {
	imagePath: string;
	alt: string;
	/** `picture` scales smoothly; `pixelart` and `mcskin` use nearest-neighbour. */
	mode: 'picture' | 'pixelart' | 'mcskin';
	mask?: boolean;
	maskAlertTitle?: string;
	maskAlertDesc?: string;
}

const {
	imagePath,
	alt,
	mode,
	mask = false,
	maskAlertTitle = 'ネタバレ注意',
	maskAlertDesc,
} = Astro.props;

// images.qwaxgo.com rejects foreign Referers (hotlink protection), so localhost
// must send none during dev. Production keeps the default qwaxgo.com Referer.
const referrerPolicy = import.meta.env.DEV ? 'no-referrer' : undefined;
---

{
	mask ? (
		<details class="group my-8 overflow-hidden rounded-xl border border-border-default bg-bg-surface shadow-sm">
			<summary class="flex cursor-pointer list-none items-center gap-3 px-5 py-4 leading-normal focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none [&::-webkit-details-marker]:hidden">
				<Icon name="Next" class="h-4 w-4 text-text-muted transition-transform group-open:rotate-90" />
				<Icon name="Warning" class="h-5 w-5 text-amber-600 dark:text-amber-300" />
				<span class="flex flex-col gap-0.5">
					<strong class="text-sm font-semibold text-text-heading">{maskAlertTitle}</strong>
					{maskAlertDesc && <span class="text-xs text-text-muted">{maskAlertDesc}</span>}
				</span>
			</summary>
			<div class="checkerboard flex flex-col items-center gap-4 border-t border-border-default p-6">
				{mode === 'mcskin' ? (
					<SkinViewer src={imagePath} alt={alt} />
				) : (
					<img
						src={imagePath}
						alt={alt}
						loading="lazy"
						referrerpolicy={referrerPolicy}
						class:list={[
							'w-full max-w-[640px] rounded-none',
							{ '[image-rendering:pixelated]': mode === 'pixelart' },
						]}
					/>
				)}
			</div>
		</details>
	) : (
		<div class="checkerboard my-8 flex flex-col items-center gap-4 rounded-xl border border-border-default p-6">
			{mode === 'mcskin' ? (
				<SkinViewer src={imagePath} alt={alt} />
			) : (
				<img
					src={imagePath}
					alt={alt}
					loading="lazy"
					referrerpolicy={referrerPolicy}
					class:list={[
						'w-full max-w-[640px] rounded-none',
						{ '[image-rendering:pixelated]': mode === 'pixelart' },
					]}
				/>
			)}
		</div>
	)
}
