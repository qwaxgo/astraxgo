---
import { Image } from 'astro:assets';
import { COLLECTION_LABELS, type TaggedEntry } from '../lib/tags';
import FormattedDate from './FormattedDate.astro';

interface Props {
	entry: TaggedEntry;
	/** Heading level of the title, to fit the page's outline. */
	headingLevel?: 2 | 3;
}

// One entry of any collection as a row: thumbnail, type, date, title, description, tags.
// Used by the tag search and the recent posts on the home page.
const { entry, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;

// images.qwaxgo.com rejects foreign Referers (hotlink protection), so localhost
// must send none during dev. Production keeps the default qwaxgo.com Referer.
const referrerPolicy = import.meta.env.DEV ? 'no-referrer' : undefined;
---

<a
	class="flex h-full gap-4 rounded-xl border border-border-default bg-bg-surface p-4 shadow-sm transition-shadow hover:shadow-md focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
	href={entry.href}
>
	<div
		class="flex h-20 w-20 flex-none items-center justify-center overflow-hidden rounded-lg bg-bg-page-alt sm:h-24 sm:w-24"
	>
		{
			typeof entry.thumbnail === 'string' ? (
				<img
					class:list={[
						'h-full w-full',
						entry.collection === 'mcskins' ? 'object-contain' : 'object-cover',
						{ '[image-rendering:pixelated]': entry.collection !== 'pictures' },
					]}
					src={entry.thumbnail}
					alt=""
					loading="lazy"
					referrerpolicy={referrerPolicy}
				/>
			) : entry.thumbnail ? (
				<Image
					src={entry.thumbnail}
					alt=""
					width={192}
					class:list={[
						'h-full w-full',
						entry.collection === 'apps' ? 'object-cover object-left-top' : 'object-contain',
					]}
				/>
			) : (
				<span class="text-xs text-text-muted">{COLLECTION_LABELS[entry.collection]}</span>
			)
		}
	</div>
	<div class="flex min-w-0 flex-1 flex-col">
		<p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-muted">
			<span
				class="inline-flex items-center rounded-full bg-bg-accent-subtle px-3 py-1 font-medium text-text-accent"
			>
				{COLLECTION_LABELS[entry.collection]}
			</span>
			<FormattedDate date={entry.pubDate} />
		</p>
		<Heading class="mt-1.5 text-lg font-semibold text-text-heading">{entry.title}</Heading>
		<p class="mt-1 line-clamp-2 text-sm text-body">{entry.description}</p>
		{
			entry.tags.length > 0 && (
				<p class="mt-auto pt-2 text-xs text-text-muted">{entry.tags.map(tag => `#${tag}`).join(' ')}</p>
			)
		}
	</div>
</a>
