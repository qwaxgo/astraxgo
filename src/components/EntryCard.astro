---
import { Image } from 'astro:assets';
import { COLLECTION_LABELS, type TaggedEntry } from '../lib/tags';
import FormattedDate from './FormattedDate.astro';

interface Props {
	entry: TaggedEntry;
	/** Heading level of the title, to fit the page's outline. */
	headingLevel?: 2 | 3;
}

// One entry of any collection as a row: thumbnail, type, date, title, description, tags.
// Used by the tag search and the recent posts on the home page.
const { entry, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;

// images.qwaxgo.com rejects foreign Referers (hotlink protection), so localhost
// must send none during dev. Production keeps the default qwaxgo.com Referer.
const referrerPolicy = import.meta.env.DEV ? 'no-referrer' : undefined;
---

<a class="entry-card" href={entry.href}>
	<div class:list={['thumb', entry.collection]}>
		{
			typeof entry.thumbnail === 'string' ? (
				<img
					class:list={{ pixelated: entry.collection !== 'pictures' }}
					src={entry.thumbnail}
					alt=""
					loading="lazy"
					referrerpolicy={referrerPolicy}
				/>
			) : entry.thumbnail ? (
				<Image src={entry.thumbnail} alt="" width={160} />
			) : (
				<span class="placeholder">{COLLECTION_LABELS[entry.collection]}</span>
			)
		}
	</div>
	<div class="body">
		<p class="meta">
			<span class="type">{COLLECTION_LABELS[entry.collection]}</span>
			<FormattedDate date={entry.pubDate} />
		</p>
		<Heading class="title">{entry.title}</Heading>
		<p class="description">{entry.description}</p>
		<p class="entry-tags">{entry.tags.map(tag => `#${tag}`).join(' ')}</p>
	</div>
</a>

<style>
	.entry-card {
		display: flex;
		gap: 1em;
		padding: 0.75em;
		border-radius: 12px;
		background: var(--surface);
		box-shadow: var(--box-shadow);
		text-decoration: none;
		transition: box-shadow 0.15s ease;
	}
	.entry-card:hover,
	.entry-card:focus-visible {
		box-shadow: 0 0 0 3px var(--accent);
		outline: none;
	}
	.thumb {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 96px;
		height: 96px;
		border-radius: 8px;
		overflow: hidden;
		background: var(--surface-muted);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		margin: 0;
		border-radius: 0;
		object-fit: cover;
	}
	.thumb img.pixelated {
		image-rendering: pixelated;
	}
	.thumb.mcskins img {
		object-fit: contain;
	}
	.thumb.apps img {
		object-position: top left;
	}
	.placeholder {
		color: var(--muted-text-color);
		font-size: 0.8em;
	}
	.body {
		min-width: 0;
	}
	.meta {
		display: flex;
		gap: 0.75em;
		margin: 0;
		color: var(--muted-text-color);
		font-size: 0.85em;
	}
	.type {
		color: var(--accent);
		font-weight: 700;
	}
	.title {
		margin: 0.15em 0 0.25em 0;
		color: var(--heading-color);
		font-size: 1.1rem;
		line-height: 1.35;
	}
	.description {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--text-color);
		font-size: 0.9em;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}
	.entry-tags {
		margin: 0.3em 0 0 0;
		color: var(--muted-text-color);
		font-size: 0.8em;
	}
</style>
