---
import EntryCard from '../../components/EntryCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTaggedEntries } from '../../lib/tags';

const posts = (await getTaggedEntries()).filter(entry => entry.collection === 'blog');
---

<BaseLayout title="ブログ" description="qwaxgoのブログ記事の一覧です">
	<PageHeader title="ブログ" description="ブログ記事の一覧です" />
	{
		posts.length === 0 ? (
			<p class="py-16 text-center text-base text-text-muted">まだ投稿はありません。</p>
		) : (
			<ul class="grid grid-cols-1 gap-4">
				{posts.map(post => (
					<li>
						<EntryCard entry={post} />
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>
