---
import { type CollectionEntry, getCollection } from 'astro:content';
import AppDetail from '../../components/AppDetail.astro';
import GalleryPost from '../../layouts/GalleryPost.astro';

// Standalone page for each app: what the /apps/ popup links fall back to without
// JavaScript, and what RSS / OG images / search engines point at.
export async function getStaticPaths() {
	const entries = await getCollection('apps');
	return entries.map(entry => ({
		params: { slug: entry.id },
		props: entry,
	}));
}
type Props = CollectionEntry<'apps'>;

const entry = Astro.props;
---

<GalleryPost {...entry.data} id={entry.id} collection="apps">
	<AppDetail entry={entry} />
</GalleryPost>
