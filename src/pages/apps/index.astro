---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import AppDetail from '../../components/AppDetail.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import TagLinks from '../../components/TagLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAppScreenshot } from '../../lib/appScreenshots';

const entries = (await getCollection('apps', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map(entry => ({ entry, screenshot: getAppScreenshot(entry.id) }));
---

<BaseLayout title="アプリ" description="GitHub Pagesで公開しているアプリの一覧です">
	<PageHeader title="アプリ" description="GitHub Pagesで公開しているアプリの一覧です" />
	<ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
		{
			entries.map(({ entry, screenshot }) => (
				<li class="flex h-full flex-col overflow-hidden rounded-xl border border-border-default bg-bg-surface shadow-sm transition-shadow hover:shadow-md">
					<a href={`/apps/${entry.id}/`} data-app-id={entry.id} class="flex flex-1 flex-col focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none">
						<div class="aspect-[16/10] border-b border-border-default bg-bg-page-alt">
							{screenshot && (
								<Image
									src={screenshot}
									alt=""
									widths={[400, 800]}
									sizes="400px"
									class="block h-full w-full object-cover object-left-top"
								/>
							)}
						</div>
						<div class="flex flex-1 flex-col px-6 pt-5">
							<h2 class="text-lg font-semibold text-text-heading">{entry.data.title}</h2>
							<p class="mt-2 text-sm text-body">{entry.data.description}</p>
							<p class="mt-auto pt-2 text-xs text-text-muted">
								<FormattedDate date={entry.data.pubDate} />
							</p>
						</div>
					</a>
					<div class="px-6 pt-3 pb-5">
						<a
							href={entry.data.url}
							target="_blank"
							rel="noopener"
							class="inline-flex h-8 items-center justify-center gap-1.5 rounded-lg bg-primary-500 px-3 text-[0.875rem] font-medium text-white transition-colors hover:bg-primary-700 focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none relative after:absolute after:inset-x-0 after:top-1/2 after:h-11 after:-translate-y-1/2"
						>
							<Icon name="OpenInNew" class="h-4 w-4" />
							アプリを開く
						</a>
					</div>
				</li>
			))
		}
	</ul>
	{
		entries.map(({ entry }) => (
			<dialog
				id={`app-${entry.id}`}
				aria-labelledby={`app-${entry.id}-title`}
				class="app-dialog m-auto max-h-[calc(100%-2rem)] w-[min(760px,calc(100%-2rem))] rounded-xl border border-border-default bg-bg-surface p-0 text-body shadow-xl backdrop:bg-black/50"
			>
				<div class="flex items-start justify-between gap-4 border-b border-border-default px-6 py-4">
					<div>
						<h2 id={`app-${entry.id}-title`} class="text-lg font-semibold text-text-heading">
							{entry.data.title}
						</h2>
						<p class="text-xs text-text-muted">
							<FormattedDate date={entry.data.pubDate} />
						</p>
					</div>
					<button
						type="button"
						aria-label="閉じる"
						data-close
						autofocus
						class="inline-flex h-10 w-10 flex-none cursor-pointer items-center justify-center rounded-lg text-text-muted transition-colors hover:bg-bg-page-alt hover:text-text-heading focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
					>
						<Icon name="Close" />
					</button>
				</div>
				<div class="px-6 py-6">
					<div class="mb-6">
						<TagLinks tags={entry.data.tags} />
					</div>
					<AppDetail entry={entry} />
				</div>
			</dialog>
		))
	}
</BaseLayout>

<script>
	// Cards link to /apps/<id>/ (the no-JS fallback); with JS they open the app's
	// popup instead and put #<id> in the URL so the popup itself can be shared.
	const dialogFor = (id: string) =>
		document.getElementById(`app-${id}`) as HTMLDialogElement | null;

	function openApp(id: string) {
		const dialog = dialogFor(id);
		if (!dialog) return false;
		dialog.showModal();
		history.replaceState(null, '', `#${id}`);
		return true;
	}

	document.querySelectorAll<HTMLAnchorElement>('a[data-app-id]').forEach(link => {
		link.addEventListener('click', event => {
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
			if (openApp(link.dataset.appId!)) event.preventDefault();
		});
	});

	document.querySelectorAll<HTMLDialogElement>('.app-dialog').forEach(dialog => {
		dialog.addEventListener('close', () =>
			history.replaceState(null, '', location.pathname + location.search),
		);
		dialog.addEventListener('click', event => {
			// The <dialog> itself is only the click target when the backdrop is clicked.
			if (event.target === dialog || (event.target as HTMLElement).closest('[data-close]')) {
				dialog.close();
			}
		});
	});

	const openFromHash = () => {
		const id = decodeURIComponent(location.hash.slice(1));
		if (id && !dialogFor(id)?.open) openApp(id);
	};
	window.addEventListener('hashchange', openFromHash);
	openFromHash();
</script>
