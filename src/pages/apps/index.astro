---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getAppScreenshot } from '../../lib/appScreenshots';

const entries = (await getCollection('apps', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map(entry => ({ entry, screenshot: getAppScreenshot(entry.id) }));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title="アプリ" description="GitHub Pagesで公開しているアプリの一覧です" />
	</head>
	<body>
		<Header />
		<main>
			<h1>アプリ</h1>
			<ul class="app-list">
				{
					entries.map(({ entry, screenshot }) => (
						<li>
							<a class="detail" href={`/apps/${entry.id}/`}>
								<div class="thumb">
									{screenshot && (
										<Image src={screenshot} alt="" widths={[400, 800]} sizes="400px" />
									)}
								</div>
								<div class="body">
									<h3 class="title">{entry.data.title}</h3>
									<p class="description">{entry.data.description}</p>
									<p class="date">
										<FormattedDate date={entry.data.pubDate} />
									</p>
								</div>
							</a>
							<a class="open" href={entry.data.url} target="_blank" rel="noopener">
								アプリを開く ↗
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.app-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style-type: none;
	}
	.app-list li {
		display: flex;
		flex-direction: column;
		border-radius: 12px;
		overflow: hidden;
		background: var(--surface);
		box-shadow: var(--box-shadow);
		transition: box-shadow 0.15s ease;
	}
	.app-list li:hover {
		box-shadow: 0 0 0 3px var(--accent);
	}
	.detail {
		flex: 1;
		text-decoration: none;
	}
	.thumb {
		aspect-ratio: 16 / 10;
		border-bottom: 1px solid var(--border-color);
		background: var(--surface-muted);
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		border-radius: 0;
		object-fit: cover;
		object-position: top left;
	}
	.body {
		padding: 1em 1.25em 0.5em;
	}
	.title {
		margin: 0 0 0.4em 0;
		color: var(--heading-color);
		line-height: 1.3;
		font-size: 1.15rem;
	}
	.detail:hover .title {
		color: var(--accent);
	}
	.description {
		margin: 0;
		color: var(--text-color);
		font-size: 0.95em;
	}
	.date {
		margin: 0.5em 0 0 0;
		color: var(--muted-text-color);
		font-size: 0.9em;
	}
	.open {
		align-self: flex-start;
		margin: 0.5em 1.25em 1.25em;
		padding: 0.5em 1.2em;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
	}
	.open:hover,
	.open:focus-visible {
		box-shadow: 0 0 0 3px var(--accent);
		outline: none;
	}
</style>
