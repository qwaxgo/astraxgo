---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import AppDetail from '../../components/AppDetail.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getAppScreenshot } from '../../lib/appScreenshots';

const entries = (await getCollection('apps', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map(entry => ({ entry, screenshot: getAppScreenshot(entry.id) }));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title="アプリ" description="GitHub Pagesで公開しているアプリの一覧です" />
	</head>
	<body>
		<Header />
		<main>
			<h1>アプリ</h1>
			<ul class="app-list">
				{
					entries.map(({ entry, screenshot }) => (
						<li>
							<a class="detail" href={`/apps/${entry.id}/`} data-app-id={entry.id}>
								<div class="thumb">
									{screenshot && (
										<Image src={screenshot} alt="" widths={[400, 800]} sizes="400px" />
									)}
								</div>
								<div class="body">
									<h3 class="title">{entry.data.title}</h3>
									<p class="description">{entry.data.description}</p>
									<p class="date">
										<FormattedDate date={entry.data.pubDate} />
									</p>
								</div>
							</a>
							<a class="open" href={entry.data.url} target="_blank" rel="noopener">
								アプリを開く ↗
							</a>
						</li>
					))
				}
			</ul>
			{
				entries.map(({ entry }) => (
					<dialog class="app-dialog" id={`app-${entry.id}`} aria-labelledby={`app-${entry.id}-title`}>
						<div class="dialog-body">
							<button type="button" class="close" aria-label="閉じる" data-close autofocus>
								×
							</button>
							<h2 id={`app-${entry.id}-title`}>{entry.data.title}</h2>
							<p class="dialog-meta">
								<FormattedDate date={entry.data.pubDate} />
								{entry.data.tags.map(tag => (
									<span class="tag">#{tag}</span>
								))}
							</p>
							<AppDetail entry={entry} />
						</div>
					</dialog>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<script>
	// Cards link to /apps/<id>/ (the no-JS fallback); with JS they open the app's
	// popup instead and put #<id> in the URL so the popup itself can be shared.
	const dialogFor = (id: string) =>
		document.getElementById(`app-${id}`) as HTMLDialogElement | null;

	function openApp(id: string) {
		const dialog = dialogFor(id);
		if (!dialog) return false;
		dialog.showModal();
		history.replaceState(null, '', `#${id}`);
		return true;
	}

	document.querySelectorAll<HTMLAnchorElement>('a[data-app-id]').forEach(link => {
		link.addEventListener('click', event => {
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
			if (openApp(link.dataset.appId!)) event.preventDefault();
		});
	});

	document.querySelectorAll<HTMLDialogElement>('.app-dialog').forEach(dialog => {
		dialog.addEventListener('close', () =>
			history.replaceState(null, '', location.pathname + location.search),
		);
		dialog.addEventListener('click', event => {
			// The <dialog> itself is only the click target when the backdrop is clicked.
			if (event.target === dialog || (event.target as HTMLElement).closest('[data-close]')) {
				dialog.close();
			}
		});
	});

	const openFromHash = () => {
		const id = decodeURIComponent(location.hash.slice(1));
		if (id && !dialogFor(id)?.open) openApp(id);
	};
	window.addEventListener('hashchange', openFromHash);
	openFromHash();
</script>

<style>
	.app-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style-type: none;
	}
	.app-list li {
		display: flex;
		flex-direction: column;
		border-radius: 12px;
		overflow: hidden;
		background: var(--surface);
		box-shadow: var(--box-shadow);
		transition: box-shadow 0.15s ease;
	}
	.app-list li:hover {
		box-shadow: 0 0 0 3px var(--accent);
	}
	.detail {
		flex: 1;
		text-decoration: none;
	}
	.thumb {
		aspect-ratio: 16 / 10;
		border-bottom: 1px solid var(--border-color);
		background: var(--surface-muted);
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		border-radius: 0;
		object-fit: cover;
		object-position: top left;
	}
	.body {
		padding: 1em 1.25em 0.5em;
	}
	.title {
		margin: 0 0 0.4em 0;
		color: var(--heading-color);
		line-height: 1.3;
		font-size: 1.15rem;
	}
	.detail:hover .title {
		color: var(--accent);
	}
	.description {
		margin: 0;
		color: var(--text-color);
		font-size: 0.95em;
	}
	.date {
		margin: 0.5em 0 0 0;
		color: var(--muted-text-color);
		font-size: 0.9em;
	}
	.open {
		align-self: flex-start;
		margin: 0.5em 1.25em 1.25em;
		padding: 0.5em 1.2em;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
	}
	.open:hover,
	.open:focus-visible {
		box-shadow: 0 0 0 3px var(--accent);
		outline: none;
	}
	.app-dialog {
		width: min(760px, calc(100% - 2em));
		max-height: calc(100% - 2em);
		padding: 0;
		border: none;
		border-radius: 16px;
		background: var(--surface);
		color: var(--text-color);
		box-shadow: var(--elevated-shadow);
	}
	.app-dialog::backdrop {
		background: rgb(0 0 0 / 0.55);
	}
	.dialog-body {
		position: relative;
		padding: 2em 1.5em 1.5em;
	}
	.dialog-body h2 {
		margin: 0 2em 0.3em 0;
		line-height: 1.3;
	}
	.dialog-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
		margin: 0 0 1.25em 0;
		color: var(--muted-text-color);
		font-size: 0.9em;
	}
	.dialog-meta .tag {
		color: var(--accent);
	}
	.close {
		position: absolute;
		top: 0.75em;
		right: 0.75em;
		width: 2.25em;
		height: 2.25em;
		border: 1px solid var(--border-color);
		border-radius: 999px;
		background: var(--surface);
		color: var(--heading-color);
		font-size: 1.1em;
		line-height: 1;
		cursor: pointer;
	}
	.close:hover,
	.close:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
		outline: none;
	}
</style>
