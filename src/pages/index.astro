---
import EntryCard from '../components/EntryCard.astro';
import Icon from '../components/Icon.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { websiteLd } from '../lib/structuredData';
import { getTaggedEntries } from '../lib/tags';

const RECENT_COUNT = 10;

// Newest entries of every category (blog, illustrations, pixel art, skins, apps).
const recent = (await getTaggedEntries()).slice(0, RECENT_COUNT);
---

<BaseLayout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	structuredData={websiteLd(Astro.site!)}
>
	<section>
		<h1 class="text-3xl font-bold text-text-heading">qwaxgo.com</h1>
		<p class="mt-2 text-base text-body">
			qwaxgo.comにようこそ！
			この度リニューアルオープンしました！
		</p>
	</section>

	<section class="mt-14" aria-labelledby="recent-heading">
		<div class="mb-6 flex items-end justify-between gap-4">
			<h2 id="recent-heading" class="text-2xl font-bold text-text-heading">最近の投稿</h2>
			<a
				href="/tags/"
				class="inline-flex items-center gap-1 rounded-lg text-sm font-medium text-text-accent hover:underline focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
			>
				すべての投稿を見る
				<Icon name="Next" class="h-4 w-4" />
			</a>
		</div>
		<ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
			{
				recent.map(entry => (
					<li>
						<EntryCard entry={entry} headingLevel={3} />
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
