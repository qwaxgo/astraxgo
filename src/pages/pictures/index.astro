---
import { getCollection } from 'astro:content';
import ContentGrid from '../../components/ContentGrid.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('pictures', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="イラスト" description="オリジナルイラストの一覧です">
	<PageHeader title="イラスト" description="オリジナルイラストの一覧です" />
	<ContentGrid entries={entries} basePath="pictures" thumbnailMode="picture" />
</BaseLayout>
