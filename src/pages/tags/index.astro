---
import EntryCard from '../../components/EntryCard.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COLLECTION_LABELS, getTaggedEntries, TAGGED_COLLECTIONS } from '../../lib/tags';

const entries = await getTaggedEntries();

// Most used tags first, then by name.
const tagCounts = new Map<string, number>();
for (const tag of entries.flatMap(entry => entry.tags)) {
	tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts.keys()].sort(
	(a, b) => tagCounts.get(b)! - tagCounts.get(a)! || a.localeCompare(b, 'ja'),
);

const types = [{ value: '', label: 'すべて' }, ...TAGGED_COLLECTIONS.map(c => ({ value: c, label: COLLECTION_LABELS[c] }))];
---

<BaseLayout title="タグ検索" description="ブログ・イラスト・マイクラスキン・アプリをタグで検索できます">
	<PageHeader title="タグ検索" description="ブログ・イラスト・ドット絵・マイクラスキン・アプリをタグで探せます" />

	<fieldset class="mb-6 min-w-0 overflow-x-auto border-b border-border-default">
		<legend class="sr-only">種類</legend>
		<div class="flex">
			{
				types.map(({ value, label }) => (
					<label class="relative cursor-pointer">
						<input type="radio" name="type" value={value} checked={value === ''} class="peer sr-only" />
						<span class="-mb-px block border-b-2 border-transparent px-4 py-2.5 text-sm font-medium whitespace-nowrap text-text-muted transition-colors peer-checked:border-primary-500 peer-checked:font-semibold peer-checked:text-text-accent peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500/50 hover:text-text-heading">
							{label}
						</span>
					</label>
				))
			}
		</div>
	</fieldset>

	<div class="mb-6 rounded-xl border border-border-default bg-bg-surface p-6 shadow-sm">
		<div class="relative mb-4 leading-normal">
			<Icon name="Search" class="pointer-events-none absolute top-1/2 left-3 h-5 w-5 -translate-y-1/2 text-text-muted" />
			<input
				type="search"
				class="tag-filter w-full rounded-lg border border-border-strong bg-bg-surface py-2 pr-3 pl-10 text-base text-text-heading caret-primary-500 placeholder:text-text-muted focus:border-primary-500 focus:ring-2 focus:ring-primary-500/50 focus:outline-none"
				placeholder="タグを絞り込む…"
				aria-label="タグ名で絞り込む"
			/>
		</div>
		<ul class="tag-chips flex flex-wrap gap-2" aria-label="タグ">
			{
				tags.map(tag => (
					<li>
						<button
							type="button"
							data-tag={tag}
							aria-pressed="false"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-border-default bg-bg-surface px-3 py-1 text-sm font-medium text-body transition-colors hover:bg-bg-surface-alt aria-pressed:border-primary-200 aria-pressed:bg-bg-accent-subtle aria-pressed:text-text-accent dark:aria-pressed:border-primary-800 focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none"
						>
							#{tag}
							<span class="count text-xs text-text-muted">{tagCounts.get(tag)}</span>
						</button>
					</li>
				))
			}
		</ul>
	</div>

	<div class="mb-4 flex items-center gap-4" aria-live="polite">
		<p class="text-sm text-text-muted"><span class="result-count font-semibold text-text-heading">{entries.length}</span>件</p>
		<button
			type="button"
			class="clear inline-flex h-8 cursor-pointer items-center justify-center rounded-lg border border-border-default bg-bg-surface px-3 text-[0.875rem] font-medium text-body transition-colors hover:bg-bg-surface-alt focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none relative after:absolute after:inset-x-0 after:top-1/2 after:h-11 after:-translate-y-1/2"
			hidden
		>
			条件をクリア
		</button>
	</div>

	<ul class="results grid grid-cols-1 gap-4">
		{
			entries.map(entry => (
				<li data-collection={entry.collection} data-tags={JSON.stringify(entry.tags)}>
					<EntryCard entry={entry} />
				</li>
			))
		}
	</ul>
	<p class="empty py-16 text-center text-base text-text-muted" hidden>条件に合うものはありません。</p>
</BaseLayout>

<script>
	// State lives in the URL (?type=<collection>&tag=<a>&tag=<b>) so searches can be
	// shared and the tag links on each post land on a pre-filtered page.
	// Selected tags narrow the results together (AND).
	const typeInputs = [...document.querySelectorAll<HTMLInputElement>('input[name="type"]')];
	const chips = [...document.querySelectorAll<HTMLButtonElement>('.tag-chips button')];
	const results = [...document.querySelectorAll<HTMLLIElement>('.results > li')].map(el => ({
		el,
		collection: el.dataset.collection!,
		tags: JSON.parse(el.dataset.tags!) as string[],
	}));
	const tagFilter = document.querySelector<HTMLInputElement>('.tag-filter')!;
	const resultCount = document.querySelector('.result-count')!;
	const clearButton = document.querySelector<HTMLButtonElement>('.clear')!;
	const empty = document.querySelector<HTMLElement>('.empty')!;

	const params = new URLSearchParams(location.search);
	let type = params.get('type') ?? '';
	const selected = new Set(params.getAll('tag'));
	if (!typeInputs.some(input => input.value === type)) type = '';

	function render() {
		const inType = results.filter(r => !type || r.collection === type);
		const matches = inType.filter(r => [...selected].every(tag => r.tags.includes(tag)));
		const shown = new Set(matches);
		for (const r of results) r.el.hidden = !shown.has(r);

		// Chip counts follow the chosen type; tags absent from it are hidden
		// unless selected, so a selection can always be undone.
		const query = tagFilter.value.trim().toLowerCase();
		for (const chip of chips) {
			const tag = chip.dataset.tag!;
			const count = inType.filter(r => r.tags.includes(tag)).length;
			const isSelected = selected.has(tag);
			chip.setAttribute('aria-pressed', String(isSelected));
			chip.querySelector('.count')!.textContent = String(count);
			chip.parentElement!.hidden =
				!isSelected && (count === 0 || (query !== '' && !tag.toLowerCase().includes(query)));
		}

		for (const input of typeInputs) input.checked = input.value === type;
		resultCount.textContent = String(matches.length);
		empty.hidden = matches.length > 0;
		clearButton.hidden = !type && selected.size === 0;

		const next = new URLSearchParams();
		if (type) next.set('type', type);
		for (const tag of selected) next.append('tag', tag);
		const search = next.toString();
		history.replaceState(null, '', search ? `?${search}` : location.pathname);
	}

	for (const input of typeInputs) {
		input.addEventListener('change', () => {
			type = input.value;
			render();
		});
	}
	for (const chip of chips) {
		chip.addEventListener('click', () => {
			const tag = chip.dataset.tag!;
			if (!selected.delete(tag)) selected.add(tag);
			render();
		});
	}
	tagFilter.addEventListener('input', render);
	clearButton.addEventListener('click', () => {
		type = '';
		selected.clear();
		tagFilter.value = '';
		render();
	});

	render();
</script>
