---
import { Image } from 'astro:assets';
import icon from '../assets/profile/icon.png';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { ICON_CREDIT, SOCIAL_LINKS } from '../consts';
import { FAVORITES, PROFILE } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const description = `${PROFILE.name}（${PROFILE.reading}）のプロフィール`;

// Lets search engines and AI crawlers tie the listed accounts to this person.
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	url: new URL('/about/', Astro.site).href,
	mainEntity: {
		'@type': 'Person',
		name: PROFILE.name,
		alternateName: PROFILE.reading,
		jobTitle: PROFILE.facts.find(fact => fact.label === '職業')?.value,
		image: new URL(icon.src, Astro.url).href,
		sameAs: SOCIAL_LINKS.map(link => link.href),
	},
};
---

<BaseLayout
	title="About"
	description={description}
	ogImageUrl="/og/light/page/about.png"
	structuredData={structuredData}
>
	<div class="mx-auto max-w-3xl">
		<section class="flex flex-col items-center gap-4 text-center">
			<figure>
				<Image
					src={icon}
					alt={`${PROFILE.name}のアイコン`}
					width={240}
					densities={[1, 2]}
					class="mx-auto block h-40 w-40 rounded-full border border-border-default shadow-sm"
				/>
				<figcaption class="mt-2 text-xs text-text-muted">
					アイコン:
					<a
						href={ICON_CREDIT.href}
						target="_blank"
						rel="noopener"
						class="text-text-accent hover:underline"
					>
						{ICON_CREDIT.handle}
					</a>
				</figcaption>
			</figure>
			<h1 class="flex flex-col items-center text-3xl font-bold text-text-heading">
				{PROFILE.name}
				<span class="text-sm font-normal text-text-muted">{PROFILE.reading}</span>
			</h1>
		</section>

		<section class="mt-10" aria-labelledby="links-heading">
			<h2 id="links-heading" class="sr-only">リンク</h2>
			<SocialLinks labels />
		</section>

		<section class="mt-14" aria-labelledby="profile-heading">
			<h2 id="profile-heading" class="mb-4 text-2xl font-bold text-text-heading">プロフィール</h2>
			<dl class="divide-y divide-border-default rounded-xl border border-border-default bg-bg-surface px-6 shadow-sm">
				{
					PROFILE.facts.map(fact => (
						<div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr] sm:gap-4">
							<dt class="text-sm font-semibold text-text-heading">{fact.label}</dt>
							<dd class="text-sm text-body">
								{Array.isArray(fact.value) ? (
									<ul class="flex flex-wrap gap-2">
										{fact.value.map(item => (
											<li class="rounded-full bg-bg-page-alt px-3 py-1 text-xs font-medium text-body">{item}</li>
										))}
									</ul>
								) : (
									fact.value
								)}
							</dd>
						</div>
					))
				}
			</dl>

			<details class="group mt-6 rounded-xl border border-border-default bg-bg-surface shadow-sm">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-6 py-4 text-base font-semibold text-text-heading focus-visible:ring-2 focus-visible:ring-primary-500/50 focus-visible:outline-none [&::-webkit-details-marker]:hidden">
					好きなもの
					<Icon name="Next" class="h-4 w-4 text-text-muted transition-transform group-open:rotate-90" />
				</summary>
				<dl class="divide-y divide-border-default border-t border-border-default px-6">
					{
						FAVORITES.map(group => (
							<div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr] sm:gap-4">
								<dt class="text-sm font-semibold text-text-heading">{group.category}</dt>
								<dd>
									<ul class="flex flex-wrap gap-2">
										{group.items.map(item => (
											<li class="rounded-full bg-bg-page-alt px-3 py-1 text-xs font-medium text-body">{item}</li>
										))}
									</ul>
								</dd>
							</div>
						))
					}
				</dl>
			</details>
		</section>
	</div>
</BaseLayout>
