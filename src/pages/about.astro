---
import { Image } from 'astro:assets';
import icon from '../assets/profile/icon.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { ICON_CREDIT, SOCIAL_LINKS } from '../consts';
import { FAVORITES, PROFILE } from '../data/profile';

const description = `${PROFILE.name}（${PROFILE.reading}）のプロフィール`;

// Lets search engines and AI crawlers tie the listed accounts to this person.
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	url: new URL('/about/', Astro.site).href,
	mainEntity: {
		'@type': 'Person',
		name: PROFILE.name,
		alternateName: PROFILE.reading,
		jobTitle: PROFILE.facts.find(fact => fact.label === '職業')?.value,
		image: new URL(icon.src, Astro.url).href,
		sameAs: SOCIAL_LINKS.map(link => link.href),
	},
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title="About" description={description} ogImageUrl="/og/light/page/about.png" />
		<JsonLd data={structuredData} />
	</head>
	<body>
		<Header />
		<main>
			<section class="card">
				<figure class="icon">
					<Image src={icon} alt={`${PROFILE.name}のアイコン`} width={240} densities={[1, 2]} />
					<figcaption>
						アイコン: <a href={ICON_CREDIT.href} target="_blank" rel="noopener">{ICON_CREDIT.handle}</a>
					</figcaption>
				</figure>
				<h1>
					{PROFILE.name}
					<span class="reading">{PROFILE.reading}</span>
				</h1>
				<SocialLinks labels />
			</section>

			<section class="profile">
				<h2>プロフィール</h2>
				<dl class="facts">
					{
						PROFILE.facts.map(fact => (
							<div>
								<dt>{fact.label}</dt>
								<dd>
									{Array.isArray(fact.value) ? (
										<ul class="items">
											{fact.value.map(item => (
												<li>{item}</li>
											))}
										</ul>
									) : (
										fact.value
									)}
								</dd>
							</div>
						))
					}
				</dl>

				<details class="favorites">
					<summary>好きなもの</summary>
					<dl>
						{
							FAVORITES.map(group => (
								<div>
									<dt>{group.category}</dt>
									<dd>
										<ul class="items">
											{group.items.map(item => (
												<li>{item}</li>
											))}
										</ul>
									</dd>
								</div>
							))
						}
					</dl>
				</details>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 3em 1em;
	}
	.card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1em;
		margin-bottom: 3em;
		text-align: center;
	}
	.icon {
		margin: 0;
	}
	.icon img {
		display: block;
		width: 160px;
		height: 160px;
		margin: 0 auto;
		border-radius: 50%;
		box-shadow: var(--box-shadow);
	}
	.icon figcaption {
		margin-top: 0.5em;
		color: var(--muted-text-color);
		font-size: 0.8em;
	}
	h1 {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 0;
		line-height: 1.2;
	}
	.reading {
		color: var(--muted-text-color);
		font-size: 0.45em;
		font-weight: 400;
	}
	.card :global(.social-links) {
		width: 100%;
	}

	.profile h2 {
		margin: 0 0 0.75em 0;
		font-size: 1.4rem;
	}
	dl {
		margin: 0;
	}
	dl > div {
		display: grid;
		grid-template-columns: 8em 1fr;
		gap: 1em;
		padding: 0.75em 0;
		border-bottom: 1px solid var(--border-color);
	}
	dt {
		color: var(--heading-color);
		font-weight: 700;
	}
	dd {
		margin: 0;
	}
	.items {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.items li {
		padding: 0.15em 0.7em;
		border: 1px solid var(--border-color);
		border-radius: 999px;
		background: var(--surface-muted);
		font-size: 0.9em;
		line-height: 1.6;
	}
	.favorites {
		margin-top: 1.5em;
		border: 1px solid var(--border-color);
		border-radius: 12px;
		background: var(--surface);
	}
	.favorites summary {
		padding: 0.9em 1.25em;
		color: var(--heading-color);
		font-weight: 700;
		cursor: pointer;
	}
	.favorites dl {
		padding: 0 1.25em 0.5em;
	}
	.favorites dl > div:last-child {
		border-bottom: none;
	}
	@media (max-width: 560px) {
		dl > div {
			grid-template-columns: 1fr;
			gap: 0.25em;
		}
	}
</style>
