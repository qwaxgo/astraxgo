---
import { getCollection } from 'astro:content';
import ContentGrid from '../../components/ContentGrid.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('pixelarts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="ドット絵" description="ドット絵の一覧です">
	<PageHeader title="ドット絵" description="ドット絵の一覧です" />
	<ContentGrid entries={entries} basePath="pixelarts" thumbnailMode="pixelart" />
</BaseLayout>
