---
import { getCollection } from 'astro:content';
import ContentGrid from '../../components/ContentGrid.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('mcskins', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="マイクラスキン" description="配布中のMinecraftスキン一覧です">
	<PageHeader title="マイクラスキン" description="配布中のMinecraftスキン一覧です" />
	<ContentGrid entries={entries} basePath="mcskins" thumbnailMode="mcskin" />
</BaseLayout>
